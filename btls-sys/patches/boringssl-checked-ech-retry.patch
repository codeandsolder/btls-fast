diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index b0c421203..c81312548 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5152,7 +5152,6 @@ OPENSSL_EXPORT void SSL_get0_ech_name_override(const SSL *ssl,
 //
-// This function must only be called in response to an `SSL_R_ECH_REJECTED`
-// error code. Calling this function on `ssl`s that have not authenticated the
-// rejection handshake will assert in debug builds and otherwise return an
-// unparsable list.
-OPENSSL_EXPORT void SSL_get0_ech_retry_configs(
+// This function returns one if the rejection handshake was authenticated.
+// Only then is an empty result meaningful. Otherwise it returns zero and
+// sets the outputs to NULL and zero. Callers must check the return value.
+OPENSSL_EXPORT int SSL_get0_ech_retry_configs(
     const SSL *ssl, const uint8_t **out_retry_configs,
diff --git a/ssl/encrypted_client_hello.cc b/ssl/encrypted_client_hello.cc
index 31f494194..31a8b94ee 100644
