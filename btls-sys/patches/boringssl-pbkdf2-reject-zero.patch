diff --git a/crypto/evp/pbkdf_test.cc b/crypto/evp/pbkdf_test.cc
index 5daffa7d9..024129910 100644
--- a/crypto/evp/pbkdf_test.cc
+++ b/crypto/evp/pbkdf_test.cc
@@ -138,15 +138,15 @@ TEST(PBKDFTest, ZeroIterations) {
                                 1 /* iterations */, digest, key_len, key));
 
-  // Flip the first key byte (so can later test if it got set).
-  const uint8_t expected_first_byte = key[0];
-  key[0] = ~key[0];
-
-  // However calling it with iterations=0 fails.
+  // Zero iterations is invalid and must not write a one-iteration key.
+  uint8_t unchanged[sizeof(key)];
+  memset(unchanged, 0xa5, sizeof(unchanged));
+  memcpy(key, unchanged, sizeof(key));
   ASSERT_FALSE(PKCS5_PBKDF2_HMAC(kPassword, password_len, kSalt, salt_len,
                                  0 /* iterations */, digest, key_len, key));
-
-  // For backwards compatibility, the iterations == 0 case still fills in
-  // the out key.
-  EXPECT_EQ(expected_first_byte, key[0]);
+  EXPECT_EQ(Bytes(unchanged), Bytes(key));
+  EXPECT_TRUE(ErrorEquals(ERR_get_error(), ERR_LIB_EVP, EVP_R_INVALID_PARAMETERS));
+  ASSERT_FALSE(PKCS5_PBKDF2_HMAC(kPassword, password_len, kSalt, salt_len,
+                                 0 /* iterations */, digest, 0, nullptr));
+  EXPECT_TRUE(ErrorEquals(ERR_get_error(), ERR_LIB_EVP, EVP_R_INVALID_PARAMETERS));
 }
 
