@@ -7362,4 +7359,14 @@ TEST(SSLTest, EmptyCipherList) {
   EXPECT_NE(0u, sk_SSL_CIPHER_num(SSL_CTX_get_ciphers(ctx.get())));
 
+  // Strict failures leave the previous list in place.
