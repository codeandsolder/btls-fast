diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index 4efb0b4ab..9142a59ca 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -1902,5 +1902,6 @@ OPENSSL_EXPORT size_t SSL_get_all_standard_cipher_names(const char **out,
 // SSL_CTX_set_strict_cipher_list configures the cipher list for `ctx`,
 // evaluating `str` as a cipher string and returning error if `str` contains
-// anything meaningless. It returns one on success and zero on failure.
+// anything meaningless, including TLS 1.3 cipher names. It returns one on
+// success and zero on failure, leaving the previous list unchanged.
 OPENSSL_EXPORT int SSL_CTX_set_strict_cipher_list(SSL_CTX *ctx,
                                                   const char *str);
@@ -1915,5 +1916,6 @@ OPENSSL_EXPORT int SSL_CTX_set_cipher_list(SSL_CTX *ctx, const char *str);
 // SSL_set_strict_cipher_list configures the cipher list for `ssl`, evaluating
 // `str` as a cipher string and returning error if `str` contains anything
-// meaningless. It returns one on success and zero on failure.
+// meaningless, including TLS 1.3 cipher names. It returns one on success and
+// zero on failure, leaving the previous list unchanged.
 OPENSSL_EXPORT int SSL_set_strict_cipher_list(SSL *ssl, const char *str);
 
diff --git a/ssl/ssl_cipher.cc b/ssl/ssl_cipher.cc
index 9c5f2270e..86c693664 100644
--- a/ssl/ssl_cipher.cc
+++ b/ssl/ssl_cipher.cc
@@ -1237,4 +1237,8 @@ static bool ssl_cipher_process_rulestr(const char *rule_str,
           if (rule_equals(cipher.name, buf, buf_len) ||
               rule_equals(cipher.standard_name, buf, buf_len)) {
+            if (strict && SSL_CIPHER_get_min_version(&cipher) >= TLS1_3_VERSION) {
+              OPENSSL_PUT_ERROR(SSL, SSL_R_INVALID_COMMAND);
+              return false;
+            }
             cipher_id = cipher.protocol_id;
             break;
@@ -1291,4 +1295,8 @@ static bool ssl_cipher_process_rulestr(const char *rule_str,
         return false;
       }
+      if (strict && *l != '\0' && !is_cipher_list_separator(*l, strict)) {
+        OPENSSL_PUT_ERROR(SSL, SSL_R_INVALID_COMMAND);
+        return false;
+      }
       if (!ssl_cipher_strength_sort(head_p, tail_p)) {
         return false;
@@ -1454,9 +1462,11 @@ bool ssl_create_cipher_list(UniquePtr<SSLCipherPreferenceList> *out_cipher_list,
   }
 
-  *out_cipher_list = std::move(pref_list);
-
-  // Configuring an empty cipher list is an error but still updates the
-  // output.
-  if (sk_SSL_CIPHER_num((*out_cipher_list)->ciphers()) == 0) {
+  const bool empty = sk_SSL_CIPHER_num(pref_list->ciphers()) == 0;
+  // Strict configuration is transactional. The lax native API retains its
+  // documented empty-list behavior.
+  if (!empty || !strict) {
+    *out_cipher_list = std::move(pref_list);
+  }
+  if (empty) {
     OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
     return false;
