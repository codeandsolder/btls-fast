+int SSL_clear_verify_callback(SSL *ssl, int mode) {
+  auto *impl = FromOpaque(ssl);
+  check_ssl_x509_method(impl);
+  if (!impl->config) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return 0;
+  }
+  impl->config->verify_mode = mode;
+  impl->config->verify_callback = nullptr;
+  return 1;
+}
