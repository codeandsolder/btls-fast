diff --git a/crypto/pem/pem_lib.cc b/crypto/pem/pem_lib.cc
--- a/crypto/pem/pem_lib.cc
+++ b/crypto/pem/pem_lib.cc
@@ -312,12 +312,19 @@
     return 1;
   }
 
+  // The legacy PEM decoder holds both the supplied password and its derived
+  // encryption key on the stack. Cleanse them on every return path.
+  bssl::Cleanup cleanup = [&] {
+    OPENSSL_cleanse(key, sizeof(key));
+    OPENSSL_cleanse(buf, sizeof(buf));
+  };
+
   pass_len = 0;
   if (!callback) {
     callback = PEM_def_callback;
   }
   pass_len = callback(buf, PEM_BUFSIZE, /*enc=*/0, u);
-  if (pass_len < 0) {
+  if (pass_len < 0 || static_cast<size_t>(pass_len) > sizeof(buf)) {
     OPENSSL_PUT_ERROR(PEM, PEM_R_BAD_PASSWORD_READ);
     return 0;
   }
