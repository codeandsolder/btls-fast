diff --git a/ssl/handshake.cc b/ssl/handshake.cc
index 3005c4ea5..9b853d7bb 100644
--- a/ssl/handshake.cc
+++ b/ssl/handshake.cc
@@ -352,10 +352,12 @@ enum ssl_verify_result_t ssl_reverify_peer_cert(SSL_HANDSHAKE *hs,
