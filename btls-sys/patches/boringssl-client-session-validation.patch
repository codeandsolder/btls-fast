+int SSL_client_session_uses_builtin_authentication(const SSL *ssl) {
+  const auto *impl = FromOpaque(ssl);
+  const SSL_CONFIG *config = impl->config.get();
+  const SSLContext *context = impl->ctx.get();
+  if (impl->server || context->x509_method != &ssl_crypto_x509_method ||
+      !config || config->custom_verify_callback || config->verify_callback ||
+      context->app_verify_callback || context->legacy_ocsp_callback ||
+      context->reverify_on_resume || context->client_cert_cb ||
+      config->psk_client_callback || config->cert->cert_cb ||
+      !config->cert->credentials.empty()) {
+    return 0;
+  }
+  const SSLCredential *legacy = config->cert->legacy_credential.get();
+  if (legacy->pubkey || legacy->privkey || legacy->key_method) {
+    return 0;
+  }
+  const X509_STORE *store = config->cert->verify_store != nullptr
+                                ? config->cert->verify_store
+                                : context->cert_store;
+  return store != nullptr && X509_STORE_get_verify_cb(store) == nullptr;
+}
+
+int SSL_check_client_session_x509(const SSL *ssl,
+                                   const SSL_SESSION *session) {
+  const auto *impl = FromOpaque(ssl);
+  const auto *cached = FromOpaque(session);
+  if (!SSL_client_session_uses_builtin_authentication(ssl) || !impl->s3->hs ||
+      !cached || cached->is_server ||
+      cached->x509_method != &ssl_crypto_x509_method ||
+      cached->peer_cert_type != TLSEXT_cert_type_x509 ||
+      !cached->x509_chain || sk_X509_num(cached->x509_chain) == 0) {
+    return 0;
+  }
+  // No verification is requested. The caller deliberately accepts the
+  // existing certificate authentication without checking its trust chain.
+  if (impl->config->verify_mode == SSL_VERIFY_NONE) {
+    return 1;
+  }
+  long verify_result = X509_V_ERR_UNSPECIFIED;
+  uint8_t alert = SSL_AD_INTERNAL_ERROR;
+  bool ok = ssl_crypto_x509_verify_cert_chain(cached, impl->s3->hs.get(),
+                                              &verify_result, &alert);
+  ERR_clear_error();
+  return ok;
+}
