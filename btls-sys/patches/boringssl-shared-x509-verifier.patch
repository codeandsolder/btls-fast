+long SSL_verify_peer_cert_chain(SSL *ssl) {
+  auto *impl = FromOpaque(ssl);
+  if (impl->ctx->x509_method != &ssl_crypto_x509_method || !impl->config ||
+      (!impl->s3->hs && !impl->s3->established_session)) {
+    return X509_V_ERR_INVALID_CALL;
+  }
+  const SSLSession *session = ssl_get_session(impl);
+  if (session == nullptr || session->peer_cert_type != TLSEXT_cert_type_x509 ||
+      !session->x509_chain || sk_X509_num(session->x509_chain) == 0) {
+    return X509_V_ERR_INVALID_CALL;
+  }
+  long verify_result = X509_V_ERR_UNSPECIFIED;
+  uint8_t alert = SSL_AD_INTERNAL_ERROR;
+  bool ok = ssl_crypto_x509_verify_cert_chain(session, impl, false,
+                                              &verify_result, &alert);
+  ERR_clear_error();
+  if (ok) {
+    return X509_V_OK;
+  }
+  return verify_result == X509_V_OK ? X509_V_ERR_UNSPECIFIED : verify_result;
+}
