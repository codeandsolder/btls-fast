@@ -3885,4 +3885,23 @@ OPENSSL_EXPORT int SSL_CTX_add_cert_compression_alg(
 
 
+// The data-aware callbacks have the same contracts as the callbacks above,
+// with a borrowed pointer to the registered algorithm's application state.
+typedef int (*ssl_cert_compression_with_data_func_t)(
+    SSL *ssl, CBB *out, const uint8_t *in, size_t in_len, void *data);
+typedef int (*ssl_cert_decompression_with_data_func_t)(
+    SSL *ssl, CRYPTO_BUFFER **out, size_t uncompressed_len,
+    const uint8_t *in, size_t in_len, void *data);
+
+// SSL_CTX_add_cert_compression_alg_with_data registers an algorithm and
+// transfers ownership of non-null |data| on success only. |free_data| is
+// called once on context destruction. Like the original API, at least one
+// callback must be non-null and each algorithm ID may only be registered once.
+OPENSSL_EXPORT int SSL_CTX_add_cert_compression_alg_with_data(
+    SSL_CTX *ctx, uint16_t alg_id,
+    ssl_cert_compression_with_data_func_t compress,
+    ssl_cert_decompression_with_data_func_t decompress, void *data,
+    void (*free_data)(void *));
+
+
 // Next protocol negotiation.
 //
