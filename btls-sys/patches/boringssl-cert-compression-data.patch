diff --git a/ssl/internal.h b/ssl/internal.h
index aba0b4565..09c255ae9 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -2951,5 +2951,27 @@ struct CertCompressionAlg {
   ssl_cert_compression_func_t compress = nullptr;
   ssl_cert_decompression_func_t decompress = nullptr;
+  ssl_cert_compression_with_data_func_t compress_with_data = nullptr;
+  ssl_cert_decompression_with_data_func_t decompress_with_data = nullptr;
+  std::unique_ptr<void, void (*)(void *)> data{nullptr, nullptr};
   uint16_t alg_id = 0;
+
+  bool CanCompress() const {
+    return compress != nullptr || compress_with_data != nullptr;
+  }
+  bool CanDecompress() const {
+    return decompress != nullptr || decompress_with_data != nullptr;
+  }
+  bool Compress(SSL *ssl, CBB *out, const uint8_t *in, size_t len) const {
+    return compress_with_data != nullptr
+               ? compress_with_data(ssl, out, in, len, data.get()) != 0
+               : compress(ssl, out, in, len) != 0;
+  }
+  bool Decompress(SSL *ssl, CRYPTO_BUFFER **out, size_t uncompressed_len,
+                  const uint8_t *in, size_t len) const {
+    return decompress_with_data != nullptr
+               ? decompress_with_data(ssl, out, uncompressed_len, in, len,
+                                      data.get()) != 0
+               : decompress(ssl, out, uncompressed_len, in, len) != 0;
+  }
 };
 
diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index 394115665..359dff5a2 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -2622,21 +2622,57 @@ void SSL_set_alps_use_new_codepoint(SSL *ssl, int use_new) {
 }
 
-int SSL_CTX_add_cert_compression_alg(SSL_CTX *ctx, uint16_t alg_id,
-                                     ssl_cert_compression_func_t compress,
-                                     ssl_cert_decompression_func_t decompress) {
-  assert(compress != nullptr || decompress != nullptr);
-
-  auto *ctx_impl = FromOpaque(ctx);
-  for (const auto &alg : ctx_impl->cert_compression_algs) {
-    if (alg.alg_id == alg_id) {
-      return 0;
+static bool add_cert_compression_alg(SSLContext *ctx,
+                                     CertCompressionAlg alg) {
+  if (!alg.CanCompress() && !alg.CanDecompress()) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return false;
+  }
+  size_t decompress_count = 0;
+  for (const auto &existing : ctx->cert_compression_algs) {
+    if (existing.alg_id == alg.alg_id) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+      return false;
     }
+    decompress_count += existing.CanDecompress() ? 1 : 0;
   }
+  // RFC 8879's algorithm vector has a one-byte length and two-byte IDs.
+  if (alg.CanDecompress() && decompress_count >= 127) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_OVERFLOW);
+    return false;
+  }
+  return ctx->cert_compression_algs.Push(std::move(alg));
+}
 
+int SSL_CTX_add_cert_compression_alg(SSL_CTX *ctx, uint16_t alg_id,
+                                     ssl_cert_compression_func_t compress,
+                                     ssl_cert_decompression_func_t decompress) {
   CertCompressionAlg alg;
   alg.alg_id = alg_id;
   alg.compress = compress;
   alg.decompress = decompress;
-  return ctx_impl->cert_compression_algs.Push(alg);
+  return add_cert_compression_alg(FromOpaque(ctx), std::move(alg));
+}
+
+int SSL_CTX_add_cert_compression_alg_with_data(
+    SSL_CTX *ctx, uint16_t alg_id,
+    ssl_cert_compression_with_data_func_t compress,
+    ssl_cert_decompression_with_data_func_t decompress, void *data,
+    void (*free_data)(void *)) {
+  if (data == nullptr || free_data == nullptr) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  CertCompressionAlg alg;
+  alg.alg_id = alg_id;
+  alg.compress_with_data = compress;
+  alg.decompress_with_data = decompress;
+  auto *impl = FromOpaque(ctx);
+  if (!add_cert_compression_alg(impl, std::move(alg))) {
+    return 0;
+  }
+  // The insertion succeeded. From this point the native vector owns data.
+  impl->cert_compression_algs.back().data =
+      std::unique_ptr<void, void (*)(void *)>(data, free_data);
+  return 1;
 }
 
