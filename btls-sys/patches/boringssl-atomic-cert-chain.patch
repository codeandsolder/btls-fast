+int SSL_CTX_use_certificate_chain(SSL_CTX *ctx,
+                                   const STACK_OF(X509) *chain) {
+  auto *impl = FromOpaque(ctx);
+  if (impl->x509_method != &ssl_crypto_x509_method) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  return ssl_use_certificate_chain(impl->cert.get(), chain);
+}
+
+int SSL_use_certificate_chain(SSL *ssl, const STACK_OF(X509) *chain) {
+  auto *impl = FromOpaque(ssl);
+  if (!impl->config || impl->ctx->x509_method != &ssl_crypto_x509_method) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  return ssl_use_certificate_chain(impl->config->cert.get(), chain);
+}
