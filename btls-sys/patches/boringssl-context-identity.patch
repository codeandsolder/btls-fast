+OPENSSL_EXPORT SSL_CTX *SSL_get0_session_context(const SSL *ssl);
+
+// SSL_CTX_has_x509_support returns one if ctx uses the native X.509 certificate
+// method and zero for a buffer-only context.
+OPENSSL_EXPORT int SSL_CTX_has_x509_support(const SSL_CTX *ctx);
+
