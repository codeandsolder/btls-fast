+int SSL_CREDENTIAL_set_private_key_method_with_data(
+    SSL_CREDENTIAL *cred, const SSL_PRIVATE_KEY_METHOD *key_method,
+    void *data, void (*free_data)(void *)) {
+  auto *impl = FromOpaque(cred);
+  if (!impl->UsesPrivateKey() || key_method == nullptr || data == nullptr ||
+      free_data == nullptr) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return 0;
+  }
+  auto owner = MakeUnique<SSLPrivateKeyMethodData>(data, free_data);
+  if (!owner) {
+    return 0;
+  }
+  impl->privkey.reset();
+  impl->key_method = key_method;
+  impl->key_method_data = std::move(owner);
+  return 1;
+}
+
+const void *SSL_get0_private_key_method_data(const SSL *ssl) {
+  const SSL_CREDENTIAL *cred = SSL_get0_selected_credential(ssl);
+  if (cred == nullptr) {
+    return nullptr;
+  }
+  const auto *impl = FromOpaque(cred);
+  return impl->key_method_data ? impl->key_method_data->data : nullptr;
+}
