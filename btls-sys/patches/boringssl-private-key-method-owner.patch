+// SSL_CREDENTIAL_set_private_key_method_with_data installs a private-key
+// method and transfers ownership of non-null |data| on success only. The
+// non-null |free_data| callback is called once when the last credential copy
+// drops the data or replaces the method or private key. The method table must
+// outlive the credential and its copies. Returns one on success, zero on error.
+OPENSSL_EXPORT int SSL_CREDENTIAL_set_private_key_method_with_data(
+    SSL_CREDENTIAL *cred, const SSL_PRIVATE_KEY_METHOD *key_method,
+    void *data, void (*free_data)(void *));
+
+// SSL_CTX_set_private_key_method_with_data is the equivalent operation for
+// the context's legacy credential. Copies into SSL objects retain the data.
+OPENSSL_EXPORT int SSL_CTX_set_private_key_method_with_data(
+    SSL_CTX *ctx, const SSL_PRIVATE_KEY_METHOD *key_method,
+    void *data, void (*free_data)(void *));
+
+// SSL_get0_private_key_method_data returns the borrowed application data of
+// the selected credential, or NULL if there is no such data. It is intended
+// for use in private-key callbacks. Changing the credential's method or key
+// may release the data, so retain it if invoking application code can do so.
+OPENSSL_EXPORT const void *SSL_get0_private_key_method_data(const SSL *ssl);
