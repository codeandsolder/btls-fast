+// Owns opaque application state alongside a private-key method. The legacy
+// credential is copied into each connection and on context switches, so the
+// state must follow the credential rather than its current SSL_CTX.
+class SSLPrivateKeyMethodData : public RefCounted<SSLPrivateKeyMethodData> {
+ public:
+  SSLPrivateKeyMethodData(void *data, void (*free_data)(void *))
+      : RefCounted(CheckSubClass()), data(data), free_data_(free_data) {}
+
+  void *const data;
+
+ private:
+  friend RefCounted<SSLPrivateKeyMethodData>;
+  ~SSLPrivateKeyMethodData() { free_data_(data); }
+  void (*const free_data_)(void *);
+};
