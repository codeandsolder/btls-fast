+// A shared session has independent membership and lifetime in every cache.
+TEST(SSLTest, SharedSessionCacheMembership) {
+  UniquePtr<SSL_CTX> first(SSL_CTX_new(TLS_method()));
+  UniquePtr<SSL_CTX> second(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  auto shared = CreateTestSession(1);
+  auto replacement = CreateTestSession(1);
+  auto other = CreateTestSession(2);
+  ASSERT_TRUE(shared);
+  ASSERT_TRUE(replacement);
+  ASSERT_TRUE(other);
+
+  // The same reference may be inserted into distinct caches concurrently.
+  std::thread a([&] {
+    for (int i = 0; i < 100; ++i) {
+      EXPECT_TRUE(SSL_CTX_add_session(first.get(), shared.get()));
+      EXPECT_TRUE(SSL_CTX_remove_session(first.get(), shared.get()));
+    }
+    EXPECT_TRUE(SSL_CTX_add_session(first.get(), shared.get()));
+  });
+  std::thread b([&] {
+    for (int i = 0; i < 100; ++i) {
+      EXPECT_TRUE(SSL_CTX_add_session(second.get(), shared.get()));
+      EXPECT_TRUE(SSL_CTX_remove_session(second.get(), shared.get()));
+    }
+    EXPECT_TRUE(SSL_CTX_add_session(second.get(), shared.get()));
+  });
+  a.join();
+  b.join();
+  EXPECT_TRUE(CacheEquals(first.get(), {shared.get()}));
+  EXPECT_TRUE(CacheEquals(second.get(), {shared.get()}));
+
+  ASSERT_TRUE(SSL_CTX_add_session(first.get(), replacement.get()));
+  EXPECT_FALSE(SSL_CTX_remove_session(first.get(), shared.get()));
+  EXPECT_TRUE(CacheEquals(first.get(), {replacement.get()}));
+  EXPECT_TRUE(CacheEquals(second.get(), {shared.get()}));
+  SSL_CTX_sess_set_cache_size(second.get(), 1);
+  ASSERT_TRUE(SSL_CTX_add_session(second.get(), other.get()));
+  EXPECT_TRUE(CacheEquals(second.get(), {other.get()}));
+  first.reset();
+  EXPECT_TRUE(CacheEquals(second.get(), {other.get()}));
+  ASSERT_TRUE(SSL_CTX_add_session(second.get(), shared.get()));
+  SSL_CTX_flush_sessions(second.get(), 0);
+  EXPECT_TRUE(CacheEquals(second.get(), {}));
+}
