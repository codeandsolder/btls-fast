+// Eviction and flush notifications must not hold the context's cache lock.
+TEST(SSLTest, SessionCacheRemovalCallbacks) {
+  UniquePtr<SSL_CTX> ctx(SSL_CTX_new(TLS_method()));
+  ASSERT_TRUE(ctx);
+  auto first = CreateTestSession(1);
+  auto second = CreateTestSession(2);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  struct State {
+    std::vector<SSL_SESSION *> removed;
+    std::vector<size_t> sizes;
+    bool destroying = false;
+  } state;
+  SSL_CTX_set_app_data(ctx.get(), &state);
+  SSL_CTX_sess_set_remove_cb(ctx.get(), [](SSL_CTX *ctx, SSL_SESSION *session) {
+    auto *state = static_cast<State *>(SSL_CTX_get_app_data(ctx));
+    state->removed.push_back(session);
+    // Takes the cache lock again, so this also tests reentrancy.
+    state->sizes.push_back(SSL_CTX_sess_number(ctx));
+    EXPECT_FALSE(SSL_CTX_remove_session(ctx, session));
+    if (state->destroying) {
+      // Destruction cannot be undone by a removal callback.
+      EXPECT_FALSE(SSL_CTX_add_session(ctx, session));
+    }
+  });
+  SSL_CTX_sess_set_cache_size(ctx.get(), 1);
+  ASSERT_TRUE(SSL_CTX_add_session(ctx.get(), first.get()));
+  ASSERT_TRUE(SSL_CTX_add_session(ctx.get(), second.get()));
+  EXPECT_EQ(state.removed, (std::vector<SSL_SESSION *>{first.get()}));
+  EXPECT_EQ(state.sizes, (std::vector<size_t>{1}));
+  SSL_CTX_flush_sessions(ctx.get(), 0);
+  EXPECT_EQ(state.removed, (std::vector<SSL_SESSION *>{first.get(), second.get()}));
+  EXPECT_EQ(state.sizes, (std::vector<size_t>{1, 0}));
+  ASSERT_TRUE(SSL_CTX_add_session(ctx.get(), first.get()));
+  state.destroying = true;
+  ctx.reset();
+  EXPECT_EQ(state.removed.back(), first.get());
+  EXPECT_EQ(state.sizes.back(), 0u);
